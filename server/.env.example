# Copy this file to .env for local development against real Postgres.
# On Railway, set these as service variables instead — do not commit a real .env file.
#
# None of this is required just to preview the app locally — if you skip
# this file entirely and run `npm install && npm start`, the server falls
# back to a local SQLite file automatically. See DEPLOY.md "Local preview".

# Postgres connection string. Railway provides this automatically when you
# add a Postgres plugin — copy its DATABASE_URL (or DATABASE_PUBLIC_URL for
# local dev against a Railway-hosted DB) into this var. Leave this unset to
# use the local SQLite fallback instead.
DATABASE_URL=postgres://user:password@localhost:5432/maison_de_merde

# Set to "off" only for local Postgres without SSL. Leave unset/on in production.
# PGSSL=off

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset for local preview and the server will generate a temporary one
# (with a loud warning) — but it's required in production (NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-string

# Required for real photo analysis (routes/vision.js). Without it, the
# /api/vision/analyze endpoint returns 503 but the rest of the app works fine.
OPENAI_API_KEY=

# Port the server listens on. Railway sets this automatically — you usually
# don't need to set it yourself in production.
PORT=3000

NODE_ENV=development

# Only needed if you deploy the frontend separately from this backend
# (not needed for the default single-service Railway deploy).
# CORS_ORIGIN=https://your-frontend-domain.com
