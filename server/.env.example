# Copy this file to .env for local development against real Postgres.
# On Render, set these as service Environment variables instead — do not
# commit a real .env file.
#
# None of this is required just to preview the app locally — if you skip
# this file entirely and run `npm install && npm run build && npm start`
# from the repo root, the server falls back to a local SQLite file
# automatically. See ../DEPLOY.md "Local preview".

# Postgres connection string. Neon (or any Postgres host) gives you this —
# see DEPLOY.md step 1. Leave this unset to use the local SQLite fallback
# instead.
DATABASE_URL=postgres://user:password@localhost:5432/maison_de_merde

# Set to "off" only for local Postgres without SSL. Leave unset/on in production.
# PGSSL=off

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset for local preview and the server will generate a temporary one
# (with a loud warning) — but it's required in production (NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-string

# Required for real photo analysis (routes/vision.js). Without it, the
# /api/vision/analyze endpoint returns 503 but the rest of the app works fine.
OPENAI_API_KEY=

# Port the server listens on. Render sets this automatically — you usually
# don't need to set it yourself in production. Set to 3001 for local
# two-process development (see DEPLOY.md "Local development") since Next.js
# dev server takes :3000.
PORT=3000

NODE_ENV=development

# Leave unset. A separate-origin frontend deploy is NOT supported without
# editing src/auth.js's cookie (sameSite: "lax" -> "none"; secure: true) —
# the session cookie will not be sent cross-site otherwise, and every
# request past login will 401. See DEPLOY.md for why this app is always
# deployed as one same-origin service.
# CORS_ORIGIN=https://your-frontend-domain.com
